    },
    "From the power log. Energy figures are the system's own per-component estimates. Percentages assume %@ Wh per full charge." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電源ログから取得しています。エネルギーの数値はシステムによるコンポーネント別の推定値です。パーセントはフル充電を%@ Whとして計算しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自电源日志。能耗数据是系统对各组件的估算值。百分比按充满电%@ Wh计算。"
          }
        },
        "zh-Hant" : {
