    "Hourly records are available. Second-by-second network and screen events weren't kept this far back." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1時間ごとの記録があります。この時期の秒単位のネットワークおよび画面のイベントは保持されていません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
