    "Only daily totals were kept for this day, covering 08:00 to 08:00 the next morning, trimmed to the biggest consumers." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この日は1日の合計のみが保持されています。範囲は8:00から翌朝8:00までで、消費の大きい項目だけが含まれます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
