    "Import a sysdiagnose to see battery, screen time, apps and network for each day." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sysdiagnoseを読み込むと、バッテリー、画面の使用時間、アプリ、ネットワークを日ごとに確認できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入sysdiagnose即可查看每天的电池、屏幕使用情况、App和网络。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入sysdiagnose即可查看每天的電池、螢幕使用情況、App和網路。"
          }
        }
      }
    },
    "In-Use Drain" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用中の消費"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用时耗电"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用時耗電"
          }
        }
      }
    },
    "Keeping a battery at 100% for hours, especially when it's warm, ages it faster. Optimized Charging or an 80% limit in Settings › Battery › Charging reduces this." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリーを長時間100%のままにすると、特に高温時には劣化が早まります。“設定” › “バッテリー” › “充電”のバッテリー充電の最適化や80%の充電上限で軽減できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电池长时间保持100%，尤其是在发热时，会加速老化。在“设置”›“电池”›“充电”中使用优化电池充电或80%充电上限可以缓解这一情况。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電池長時間維持在100%，尤其是在發熱時，會加速老化。在「設定」›「電池」›「充電」中使用最佳化電池充電或80%充電上限可減輕此情況。"
          }
        }
      }
    },
    "Kind" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "種類"
          }
        },
