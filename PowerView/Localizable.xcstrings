    "Brightness is the screen's actual output in nits; higher brightness is one of the biggest causes of screen-on drain." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明るさは画面の実際の出力（ニト）です。明るさが高いことは、画面オン時の消費が増える大きな原因のひとつです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "亮度是屏幕的实际输出，单位为尼特；较高的亮度是屏幕打开时耗电的最大原因之一。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "亮度是螢幕的實際輸出，單位為尼特；較高的亮度是螢幕開啟時耗電的最大原因之一。"
          }
        }
      }
    },
