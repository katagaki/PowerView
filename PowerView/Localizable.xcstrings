    },
    "Large sysdiagnoses can take a minute. Keep PowerView open." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイズの大きいsysdiagnoseは1分ほどかかることがあります。PowerViewを開いたままにしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
