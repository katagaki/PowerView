    "Each day starts from the beginning of its longest stretch on battery, so tests started at different times line up." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各日は最も長いバッテリー駆動区間の開始時点から表示されるため、開始時刻の異なるテストを揃えて比較できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一天都从其最长电池供电时段的开始时间算起，因此不同时间开始的测试可以对齐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一天都從其最長電池供電時段的開始時間算起，因此不同時間開始的測試可以對齊。"
          }
        }
      }
    },
    "Each runs from when it was unplugged until it was next plugged in." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それぞれ、電源を外してから次に接続するまでの区間です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每段从拔下电源开始，到下次接入电源为止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每段從拔除電源開始，到下次接上電源為止。"
          }
        }
      }
