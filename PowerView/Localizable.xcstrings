    "Battery peaked at **%@** around %@" : {
      "comment" : "Highlight: the highest temperature and the time it happened. Text between ** is shown in bold; keep the ** in the translation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Battery peaked at **%1$@** around %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリー温度は%2$@ごろに**%1$@**まで上昇"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电池温度在%2$@前后达到**%1$@**"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電池溫度在%2$@左右達到**%1$@**"
          }
        }
      }
    },
    "Blue is energy used while the display was on, orange while it was off. Percentages assume %@ Wh per full charge." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "青は画面オン時、オレンジは画面オフ時に使用したエネルギーです。パーセントはフル充電を%@ Whとして計算しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蓝色为屏幕打开时的能耗，橙色为屏幕关闭时的能耗。百分比按充满电%@ Wh计算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "藍色為螢幕開啟時的能源用量，橙色為螢幕關閉時的能源用量。百分比以充飽電%@ Wh計算。"
          }
        }
      }
    },
    "Bluetooth" : {
      "comment" : "Why the phone woke from sleep.",
      "localizations" : {
        "ja" : {
