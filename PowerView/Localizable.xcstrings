    "Heavy CPU Use" : {
      "comment" : "A kind of diagnostic report.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPUの大量使用"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大量占用CPU"
